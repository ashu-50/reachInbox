generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScheduledEmailStatus {
  scheduled
  processing
  sent
  failed
  cancelled
}

enum CampaignStatus {
  draft
  scheduled
  running
  completed
  cancelled
}

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  name      String
  email     String   @unique
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senders          Sender[]
  campaigns        Campaign[]
  slackConnections SlackConnection[]

  @@map("users")
}

model Sender {
  id         String   @id @default(uuid())
  userId     String
  email      String
  name       String
  hourlyLimit Int     @default(100)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledEmails ScheduledEmail[]

  @@unique([userId, email])
  @@index([userId])
  @@map("senders")
}

model Campaign {
  id                 String         @id @default(uuid())
  userId             String
  subject            String
  body               String
  startTime          DateTime
  delayBetweenEmails Int
  hourlyLimit        Int
  status             CampaignStatus @default(scheduled)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledEmails ScheduledEmail[]

  @@index([userId])
  @@map("campaigns")
}

model ScheduledEmail {
  id             String               @id @default(uuid())
  campaignId     String
  senderId       String
  recipient      String
  subject        String
  body           String
  scheduledAt    DateTime
  sentAt         DateTime?
  status         ScheduledEmailStatus @default(scheduled)
  attempts       Int                  @default(0)
  bullmqJobId    String?
  idempotencyKey String               @unique
  failureReason  String?
  providerMessageId String?
  previewUrl        String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender   Sender   @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([senderId])
  @@index([status])
  @@map("scheduled_emails")
}

model SlackConnection {
  id          String   @id @default(uuid())
  userId      String
  slackUserId String
  teamId      String
  accessToken String
  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@map("slack_connections")
}
